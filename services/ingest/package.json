{
  "name": "forbright-ingest",
  "version": "1.0.0",
  "private": true,
  "description": "Ingestion service: receives forwarded onboarding payloads and persists raw events + normalized customers to Postgres.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pino": "^9.9.1",
    "pino-http": "^10.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prisma": "^6.16.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
